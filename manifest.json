{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "default_locale": "ru",
  "browser_specific_settings": {
    "gecko": {
      "id": "jump-to-clipboard@thunder.gtd",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "clipboardRead",
    "clipboardWrite",
    "notifications"
  ],
  "background": {
    "type": "module",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icons/jump.svg",
    "allowed_spaces": ["mail"]
  },
  "commands": {
    "jump-to-clipboard-message": {
      "suggested_key": {
        "default": "Ctrl+Alt+J"
      },
      "description": "__MSG_commandJump__"
    },
    "copy-subject": {
      "description": "__MSG_commandCopySubject__"
    },
    "copy-mid": {
      "description": "__MSG_commandCopyMid__"
    }
  },
  "experiment_apis": {
    "subjectCopy": {
      "schema": "api/subjectCopy/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["subjectCopy"]],
        "script": "api/subjectCopy/implementation.js"
      }
    }
  },
  "icons": {
    "16": "icons/jump.svg",
    "32": "icons/jump.svg",
    "64": "icons/jump.svg"
  }
}
