[
  {
    "namespace": "subjectCopy",
    "types": [
      {
        "id": "CurrentMessage",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["message", "none", "multiple"],
            "description": "message when one message is current, none when nothing is selected, multiple when more than one row is selected."
          },
          "subject": {
            "type": "string",
            "optional": true,
            "description": "Decoded subject. Present when kind is message."
          },
          "headerMessageId": {
            "type": "string",
            "optional": true,
            "description": "Message-ID without angle brackets. Present when kind is message."
          }
        }
      }
    ],
    "functions": [
      {
        "name": "getCurrentMessage",
        "type": "function",
        "async": "callback",
        "description": "The message a copy shortcut should use in this window: the displayed message, or the single selected row when the message pane is hidden.",
        "parameters": [
          {
            "name": "windowId",
            "type": "integer"
          },
          {
            "name": "callback",
            "type": "function",
            "parameters": [
              {
                "name": "message",
                "$ref": "CurrentMessage"
              }
            ]
          }
        ]
      },
      {
        "name": "showToast",
        "type": "function",
        "async": "callback",
        "description": "Shows a short notice in the center of the mail window. A timeout of 0 keeps it until hideToast.",
        "parameters": [
          {
            "name": "windowId",
            "type": "integer"
          },
          {
            "name": "text",
            "type": "string"
          },
          {
            "name": "timeoutMs",
            "type": "integer"
          },
          {
            "name": "callback",
            "type": "function",
            "parameters": []
          }
        ]
      },
      {
        "name": "hideToast",
        "type": "function",
        "async": "callback",
        "description": "Removes the center notice from the mail window.",
        "parameters": [
          {
            "name": "windowId",
            "type": "integer"
          },
          {
            "name": "callback",
            "type": "function",
            "parameters": []
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onCopyRequested",
        "type": "function",
        "description": "Fired when a header-toolbar copy button is pressed.",
        "parameters": [
          {
            "name": "info",
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["subject", "mid"]
              },
              "kind": {
                "type": "string",
                "enum": ["message", "none"]
              },
              "subject": {
                "type": "string",
                "optional": true
              },
              "headerMessageId": {
                "type": "string",
                "optional": true
              },
              "windowId": {
                "type": "integer",
                "optional": true,
                "description": "Mail window that contains the message header."
              }
            }
          }
        ]
      }
    ]
  }
]
